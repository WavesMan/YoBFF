# 配置文件路径
CONFIG_PATH=config/config.json

# 服务监听地址
HTTP_LISTEN_ADDR=:8080
HTTPS_LISTEN_ADDR=:8443
HTTPS_ENABLED=true
# ADMIN_LISTEN_ADDR 已废弃，管理接口已合并至主端口，路径前缀为 /admin/
# ADMIN_LISTEN_ADDR=:9090
ADMIN_API_TOKEN=change_me
ADMIN_RATE_LIMIT_PER_MIN=60

# 日志配置
LOG_LEVEL=debug
LOG_STACKTRACE_LEVEL=error

# 运行时行为
CONFIG_RELOAD_INTERVAL_SECONDS=3
SHUTDOWN_TIMEOUT_SECONDS=5

# 安全校验
ALLOWED_CIDRS=0.0.0.0/0,::/0
BLOCK_PAGE_HTML=<html><body><h1>403 Forbidden</h1></body></html>
HSTS_ENABLED=false

# 路由默认上游
DEFAULT_UPSTREAM=http://127.0.0.1:18080

# HTTPS 证书签发
# 同时指定 TLS_CA_CERT_FILE 与 TLS_CA_KEY_FILE 时使用 CA 签发，否则自动自签
TLS_CA_CERT_FILE=
TLS_CA_KEY_FILE=
