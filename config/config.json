{
    "dataPlane": {
        "httpListenAddr": ":8080",
        "httpsListenAddr": ":8443",
        "enableHttps": true
    },
    "controlPlane": {
        "adminListenAddr": ":9090"
    },
    "security": {
        "allowedCidrs": [
            "0.0.0.0/0",
            "::/0"
        ],
        "enableHsts": false
    },
    "routing": {
        "defaultUpstream": "http://127.0.0.1:18080",
        "domains": [
            {
                "domain": "example.local",
                "upstream": "http://127.0.0.1:18080",
                "forceHttps": false
            },
            {
                "domain": "*.dev.local",
                "upstream": "http://127.0.0.1:18080",
                "forceHttps": true
            }
        ]
    },
    "certificates": []
}
